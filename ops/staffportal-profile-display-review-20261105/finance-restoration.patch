+import type {WorkforceContext} from './auth';
+import type {Assignment,Company} from '../source-snapshots/DAENEM-StaffPortal-Post-SignIn-v115/app/experience/model';
+import type {CommandCenterGroup,CommandCenterNode,CommandCenterPage} from './enterprise-command-center-model';
+
+export const historicalFinanceDestinations = {
+  receivables:{title:'Receivables',permission:'finance.receivables',minimum:'view',service:'finance',tab:'receivables'},
+  budgets:{title:'Budgets',permission:'finance.budgets',minimum:'view',service:'finance',tab:'budgets'},
+  'financial-reports':{title:'Financial Reports',permission:'finance.reports',minimum:'view',service:'finance',tab:'reports'},
+  'expense-approvals':{title:'Expense Approvals',permission:'expense.approve',minimum:'view',service:'spend',tab:'approvals'},
+  'cost-admin':{title:'Cost Administration',permission:'expense.master',minimum:'manage',service:'spend',tab:'admin'},
+} as const;
+export type HistoricalFinanceId=keyof typeof historicalFinanceDestinations;
+const ranks:Record<string,number>={none:0,view:1,create:2,edit:3,approve:4,manage:5};
+export function historicalFinanceDestination(id:string){
+  return Object.prototype.hasOwnProperty.call(historicalFinanceDestinations,id)
+    ? historicalFinanceDestinations[id as HistoricalFinanceId] : undefined;
+}
+export function historicalFinanceCompanies(context:WorkforceContext,id:string){
+  const destination=historicalFinanceDestination(id);
+  if(!destination||context.employee.status.trim().toLowerCase()!=='active')return [];
+  const seen=new Set<string>();
+  return context.companies.filter(company=>{
+    if(!company.id||seen.has(company.id))return false;
+    seen.add(company.id);
+    const permissions=context.companyPermissions?.[company.id];
+    if(!permissions||!Object.prototype.hasOwnProperty.call(permissions,destination.permission))return false;
+    const level=permissions[destination.permission];
+    return typeof level==='string'&&Object.prototype.hasOwnProperty.call(ranks,level)
+      &&ranks[level]>=ranks[destination.minimum];
+  });
+}
+export function bindHistoricalFinanceContext(context:WorkforceContext,id:string,companyId:string):WorkforceContext|null{
+  const company=historicalFinanceCompanies(context,id).find(item=>item.id===companyId);
+  if(!company)return null;
+  const permissions=context.companyPermissions![company.id];
+  return {...context,companies:[company],permissions,companyPermissions:{[company.id]:permissions},
+    roles:context.roles.filter(role=>role.companyId===company.id)};
+}
+export function historicalFinanceAssignments(context:WorkforceContext,selectedCompanyId?:string):Assignment[]{
+  return Object.keys(historicalFinanceDestinations).flatMap(id=>
+    historicalFinanceCompanies(context,id).filter(company=>!selectedCompanyId||company.id===selectedCompanyId)
+      .map(company=>({module:id,level:'View' as const,
+        companies:[('assigned-company:'+encodeURIComponent(company.id)) as Company],
+        scope:'ASSIGNED' as const,capabilities:[]})));
+}
+export function withHistoricalFinanceNavigation(areas:CommandCenterGroup[],context:WorkforceContext):CommandCenterGroup[]{
+  const prune=(nodes:CommandCenterNode[]):CommandCenterNode[]=>nodes.flatMap<CommandCenterNode>(node=>{
+    if(node.kind==='page')return historicalFinanceDestination(node.moduleId)?[]:[node];
+    const children=prune(node.children);return children.length?[{...node,children}]:[];
+  });
+  const next=areas.map(area=>({...area,children:prune(area.children)}));
+  const finance=next.find(area=>area.globalId==='finance');
+  if(!finance)return next;
+  for(const company of context.companies){
+    const pages:CommandCenterPage[]=Object.entries(historicalFinanceDestinations)
+      .filter(([id])=>historicalFinanceCompanies(context,id).some(item=>item.id===company.id))
+      .map(([id,destination])=>({kind:'page',id:'finance:'+company.id+':'+id,label:destination.title,
+        route:'/'+id+'/company/'+encodeURIComponent(company.id),moduleId:id,permissionModuleId:id,
+        globalId:'finance',breadcrumb:['Finance',company.name,destination.title]}));
+    if(pages.length&&!finance.children.some(node=>node.id==='finance:assigned:'+company.id))
+      finance.children.push({kind:'group',id:'finance:assigned:'+company.id,label:company.name,
+        globalId:'finance',children:pages});
+  }
+  return next;
+}
