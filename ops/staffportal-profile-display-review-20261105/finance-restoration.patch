+export type VerifiedFinancialReport={
+  companyId:string;startDate:string;endDate:string;
+  trialBalance:{accounts:Array<{id:string;code:string;name:string;accountType:string;debitKobo:number;creditKobo:number;balanceKobo:number}>;totalDebitKobo:number;totalCreditKobo:number;balanced:boolean};
+  profitLoss:{revenueKobo:number;costOfSalesKobo:number;grossProfitKobo:number;operatingExpensesKobo:number;netProfitKobo:number};
+};
+const object=(value:unknown):value is Record<string,unknown>=>!!value&&typeof value==='object'&&!Array.isArray(value);
+const integer=(value:unknown):value is number=>Number.isSafeInteger(value);
+export function verifiedFinancialReport(value:unknown,companyId:string,startDate:string,endDate:string):value is VerifiedFinancialReport{
+  if(!object(value)||!companyId||value.companyId!==companyId||value.startDate!==startDate||value.endDate!==endDate)return false;
+  const trial=value.trialBalance,profit=value.profitLoss;
+  if(!object(trial)||!object(profit)||!Array.isArray(trial.accounts)||typeof trial.balanced!=='boolean')return false;
+  const accounts:VerifiedFinancialReport['trialBalance']['accounts']=[],ids=new Set<string>();
+  let debit=0,credit=0;
+  for(const row of trial.accounts){
+    if(!object(row)||typeof row.id!=='string'||!row.id||ids.has(row.id)||typeof row.code!=='string'||typeof row.name!=='string'
+      ||!['asset','liability','equity','revenue','expense','cost_of_sales'].includes(String(row.accountType))
+      ||!integer(row.debitKobo)||row.debitKobo<0||!integer(row.creditKobo)||row.creditKobo<0
+      ||!integer(row.balanceKobo)||row.balanceKobo!==row.debitKobo-row.creditKobo)return false;
+    debit+=row.debitKobo;credit+=row.creditKobo;
+    if(!integer(debit)||!integer(credit))return false;
+    ids.add(row.id);accounts.push(row as unknown as VerifiedFinancialReport['trialBalance']['accounts'][number]);
+  }
+  if(!integer(trial.totalDebitKobo)||!integer(trial.totalCreditKobo)||trial.totalDebitKobo!==debit
+    ||trial.totalCreditKobo!==credit||trial.balanced!==(debit===credit))return false;
+  const total=(kind:string)=>accounts.filter(row=>row.accountType===kind).reduce((sum,row)=>sum+row.balanceKobo,0);
+  const revenue=accounts.filter(row=>row.accountType==='revenue').reduce((sum,row)=>sum+Math.max(0,-row.balanceKobo),0);
+  const costs=total('cost_of_sales'),expenses=total('expense'),gross=revenue-costs,net=gross-expenses;
+  const expected={revenueKobo:revenue,costOfSalesKobo:costs,grossProfitKobo:gross,operatingExpensesKobo:expenses,netProfitKobo:net};
+  return Object.entries(expected).every(([key,number])=>integer(number)&&integer(profit[key])&&profit[key]===number);
+}
