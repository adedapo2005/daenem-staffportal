+  const bound=companyId?bindHistoricalFinanceContext(context,route,companyId):null;
+  let content;
+  if(match?.[2]&&!bound)content=<Empty title="Workspace Access Not Assigned" message="This Destination Is Not Assigned For The Requested Company."/>;
+  else if(!bound)content=<Panel title={destination.title}>
+    <p>Your Authorized Company Modules</p><div className="p-button-row">
+      {companies.map(company=><Btn key={company.id} onClick={()=>router.push('/'+route+'/company/'+encodeURIComponent(company.id))}>{company.name}</Btn>)}
+    </div>{!companies.length&&<p role="status">No Current Company Assignment Is Available.</p>}
+  </Panel>;
+  else{
+    const company=bound.companies[0],identity=JSON.stringify([path,bound]);
+    const workspace=destination.service==='finance'
+      ? <Finance context={bound} onClose={close} fixedCompanyId={company.id} fixedTab={destination.tab}/>
+      : <OfflinePlatformProvider context={bound}><Spend context={bound} onClose={close}
+          fixedCompanyId={company.id} initialTab={destination.tab} fixedTab={destination.tab}/></OfflinePlatformProvider>;
+    content=<div key={identity}><h1>{destination.title}</h1><p>{company.name}</p>
+      <Suspense fallback={<p role="status">Loading Protected Workspace...</p>}>{workspace}</Suspense></div>;
+  }
+  return createPortal(<section className="historical-live-module" data-finance-destination={route} aria-label={destination.title}>{content}</section>,mount);
+}
