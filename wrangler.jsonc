{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daenem-staffportal-api",
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2026-08-18",
  "main": "./worker/runtime.ts",
  "routes": [
    {
      "pattern": "staffportal.daenem.com/api/*",
      "zone_name": "daenem.com"
    }
  ],
  "limits": {
    "cpu_ms": 300000
  },
  // No assets binding: Pages owns normal frontend/static requests.
  // Existing data bindings remain source-compatible pending live exclusivity verification.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daenem-workforce-hub",
      "database_id": "bea49ff6-e47a-486a-8f65-c3ef9670e314",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "daenem-workforce-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SOCIAL_CACHE",
      "id": "74cfc3efb9f54ac4b243a6c0fd2ffc26"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SOCIAL_QUEUE",
        "queue": "daenem-social-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "daenem-social-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "portal@daenem.com"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "APP_NAME": "Daenem Staff Portal",
    "TIMEZONE": "Africa/Lagos",
    "APP_STAGE": "staging",
    "WORKFORCE_EMAIL_FROM": "portal@daenem.com",
    "META_GRAPH_VERSION": "v24.0"
  }
}
